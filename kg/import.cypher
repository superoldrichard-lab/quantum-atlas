MERGE (n:Entity:Company {id: 'c_quantinuum'}) SET n += {type: 'company', name: 'Quantinuum', name_en: 'Quantinuum', weight: 9, country: '美国/英国', region: '欧洲', intro: '由霍尼韦尔量子部门与剑桥量子计算（CQC）2021 年合并而成，H 系列离子阱机保持量子体积纪录，TKET 编译栈与量子化学/密码软件全栈布局；2025-09 融资 6 亿美元（投前估值 100 亿美元），2026-06 IPO，为全球估值最高的量子公司之一。', founded: '2021（前身 Cambridge Quantum 2014）', hq: '英国剑桥 / 美国科罗拉多布鲁姆菲尔德', funding: '已上市（Nasdaq: QNT；2026-06-04 传统 IPO，发行价 60 美元，发行 2800 万股募资 16.8 亿美元，上市时市值约 156 亿美元）；上市前 2025-09 获 6 亿美元融资（投前估值 100 亿美元）', business: '离子阱量子计算整机（H 系列）与量子软件（TKET、Quantum Origin）', source: 'https://www.quantinuum.com/press-releases/introducing-quantinuum', note: '2026-06-04 完成 IPO，为全球最大纯量子计算 IPO；CEO 为 Rajeeb Hazra', wikidata: 'Q111444392', verified: '是', verif_note: '2026-10 本轮网络核实', fields: '量子计算|量子软件与算法', wikidata_src: 'manual'};
MERGE (n:Entity:Company {id: 'c_ctquantum'}) SET n += {type: 'company', name: '中电信量子集团', name_en: 'China Telecom Quantum Group', weight: 7, country: '中国', region: '中国', intro: '中国电信量子板块主体（注册资本 30 亿元，国务院国资委实控链条），2025 年 1 月控股国盾量子（直接持股 21.86%、表决权 40.43%）。核心资产「天衍」量子计算云平台（2023-11 发布，全球首个量子优越性超量融合云）：截至 2026 上半年累计访问量超 5000 万、实验任务超 450 万、覆盖 60 余国；ICV TA&K 评估与 IBM Quantum Platform 并列全球第一梯队。硬件家族：天衍-504（2024-12，基于中科院量子创新院「骁鸿」芯片，与国盾联合研发）、天衍-287（2025-11，搭载中科大「祖冲之三号」同款 105 数据比特+182 耦合比特芯片，具备 4.5 亿倍量子优越性，为首个面向全球开放的优越性量子云）、天衍-P2000（「九章四号」同系列光量子，全球首个光量子优越性云服务）；并发布量子编程多智能体「Tianyan QMind」。运营全球最大规模量子城域网体系。', founded: '2023（前身中电信量子科技 2020）', hq: '合肥', funding: '央企子公司（中国电信全资，注册资本 30 亿元）', business: '量子通信网络运营、天衍量子计算云平台、量子安全产品', source: 'https://gxq.hefei.gov.cn/xwdt/mtjj/18799739.html', note: '天衍-287 联合团队：中电信量子+国盾量子（央广网 2025-11）', verified: '是', verif_note: '央广网/新华社/财联社/上交所公告', fields: '量子通信|量子计算|量子传感与测量', wikidata: 'Q131453493', wikidata_src: 'auto-label'};
MERGE (n:Entity:Company {id: 'c_wentian'}) SET n += {type: 'company', name: '问天量子', name_en: 'Qasky (Anhui Qasky Quantum Technology)', weight: 6, country: '中国', region: '中国', intro: '郭光灿、韩正甫 2009 年创立的中国第一家量子信息产业化企业，由芜湖投控与中科大共同发起。技术路线：量子保密通信（城域 QKD 网络、QKD 设备）+ 量子随机数芯片，牵头量子密码行业标准制定。融资：2026-07 完成 6 亿元 B 轮（中天汇富、合凡资产、延福基金等），地方后备上市企业。', founded: '2009', hq: '芜湖', funding: 'B 轮（2026 年 7 月，6 亿元）', business: '量子保密通信设备、量子随机数芯片、量子密码标准制定', source: 'http://www.qasky.com/', verified: '否', fields: '量子通信', wikidata: 'Q131433167', wikidata_src: 'auto-label'};
