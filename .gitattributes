# 默认自动识别文本文件并规范行尾
* text=auto

# 源码与数据统一 LF
*.py        text eol=lf
*.js        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.jsonld    text eol=lf
*.csv       text eol=lf
*.cypher    text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Windows 批处理必须 CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf

# 二进制，不做行尾转换
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.pyc       binary
